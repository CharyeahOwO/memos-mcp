# ============================================================
# memos-mcp 配置示例
# 复制本文件为 .env 并按需填写。所有变量都以 MEMOS_ 开头。
# 标注【必需】的一定要填；其余有默认值，不填也能跑。
# ============================================================

# ------------------------------------------------------------
# 第一步必需配置
# ------------------------------------------------------------

# 【必需】你的 Memos 实例地址（不要带结尾斜杠）
# 例：http://localhost:5230  或  https://memos.example.com
MEMOS_BASE_URL=

# Memos 的 Personal Access Token（在 Memos 设置里生成，形如 memos_pat_xxxx）
# - stdio 模式（本地用）：【必需】，服务器用它去连你的 Memos
# - http 模式：可留空，客户端可在每次 MCP 请求里发送
#   Authorization: Bearer <token>
MEMOS_ACCESS_TOKEN=

# 传输方式：stdio（本地，给 Claude Desktop / Cursor 等）或 http（本机/局域网 HTTP 客户端）
# 默认 stdio
MEMOS_MCP_TRANSPORT=stdio

# 仅 http 模式生效：监听地址与端口
# 默认绑 127.0.0.1。需要局域网访问时再改成 0.0.0.0，并自行处理访问控制。
MEMOS_MCP_HOST=127.0.0.1
MEMOS_MCP_PORT=8080

# 只读模式：true 时所有写工具（如 memos_create）会被隐藏，只能读
# 默认 false
MEMOS_MCP_READONLY=false

# 更新/归档工具开关：true 时注册 memos_update / memos_archive。
# 默认 false；只读模式为 true 时，即使开启本项也会隐藏这些写工具。
MEMOS_MCP_ENABLE_UPDATE_TOOLS=false

# 默认时区，影响时间检索工具（IANA 名称，如 Asia/Shanghai）
# 默认 UTC
MEMOS_MCP_TIMEZONE=UTC

# 目标 Memos 版本基线（仅用于文档/兼容性提示，暂不强制）
# 例：0.24
MEMOS_MCP_MEMOS_API_VERSION=0.24

# ------------------------------------------------------------
# 向量索引 / 语义检索（必需）
# ------------------------------------------------------------

# 本地 JSON 向量索引路径
MEMOS_MCP_INDEX_DB=./data/memos-mcp-index.json

# 目前支持 OpenAI-compatible /v1/embeddings endpoint
MEMOS_MCP_EMBEDDING_PROVIDER=openai-compatible
MEMOS_MCP_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
MEMOS_MCP_EMBEDDING_MODEL=nomic-embed-text
MEMOS_MCP_EMBEDDING_API_KEY=
MEMOS_MCP_EMBEDDING_BATCH_SIZE=32

# 本地向量索引有效期，单位分钟。默认 120 分钟；设为 0 表示永不过期。
MEMOS_MCP_INDEX_TTL_MINUTES=120

# 索引过期时 memos_search 的行为：
# - sync：先执行一次增量同步，再搜索（默认）
# - error：返回错误，要求先手动调用 memos_sync_index
# - allow：继续使用旧索引搜索，并在结果里标记过期
MEMOS_MCP_EXPIRED_INDEX_BEHAVIOR=sync

# 服务端后台定时同步间隔，单位分钟。默认 120 分钟；设为 0 关闭定时同步。
# HTTP 模式下只有配置了 MEMOS_ACCESS_TOKEN，服务端后台同步才有 token 可用。
MEMOS_MCP_SYNC_INTERVAL_MINUTES=120

# 服务启动后是否立即在后台同步一次索引。默认 true。
# 没有 MEMOS_ACCESS_TOKEN 时会自动跳过，搜索过期时仍可使用请求头 token 同步。
MEMOS_MCP_SYNC_ON_START=true
