# ============================================================
# memos-mcp 配置示例
# 复制本文件为 .env 并按需填写。所有变量都以 MEMOS_ 开头。
# 标注【必需】的一定要填；其余有默认值，不填也能跑。
# ============================================================

# ------------------------------------------------------------
# 第一步必需配置
# ------------------------------------------------------------

# 【必需】你的 Memos 实例地址（不要带结尾斜杠）
# 例：http://localhost:5230  或  https://memos.example.com
MEMOS_BASE_URL=

# Memos 的 Personal Access Token（在 Memos 设置里生成，形如 memos_pat_xxxx）
# - stdio 模式（本地用）：【必需】，服务器用它去连你的 Memos
# - http 模式（本地 HTTP 用）：可留空，因为本地 MCP 客户端可在请求头自带
#   Authorization: Bearer <token>。这不是云端多用户托管模式。
MEMOS_ACCESS_TOKEN=

# 传输方式：stdio（本地，给 Claude Desktop / Cursor 等）或 http（本机/局域网 HTTP 客户端）
# 默认 stdio
MEMOS_MCP_TRANSPORT=stdio

# 仅 http 模式生效：监听地址与端口
# 默认绑 127.0.0.1（只有本机能连，最安全）。
# 项目定位为本地部署，不提供也不推荐公网云服务；不要直接把它绑到 0.0.0.0 暴露公网。
MEMOS_MCP_HOST=127.0.0.1
MEMOS_MCP_PORT=8080

# 新建笔记的默认可见性：PRIVATE（私密）/ PROTECTED（登录可见）/ PUBLIC（公开）
# 默认 PRIVATE，保守起见
MEMOS_MCP_DEFAULT_VISIBILITY=PRIVATE

# 只读模式：true 时所有写工具（如 memos_create）会被隐藏，只能读
# 默认 false
MEMOS_MCP_READONLY=false

# 默认时区，影响将来的时间检索功能（IANA 名称，如 Asia/Shanghai）
# 默认 UTC
MEMOS_MCP_TIMEZONE=UTC

# 目标 Memos 版本基线（仅用于文档/兼容性提示，暂不强制）
# 例：0.24
MEMOS_MCP_MEMOS_API_VERSION=0.24

# ------------------------------------------------------------
# 第二种部署方式预留：本地部署 + 向量 / 语义搜索 / 本地索引。
# 基础本地检索版不用填；开启向量版时再按文档配置。
# ------------------------------------------------------------

# MEMOS_MCP_INDEX_DB=./data/memos-mcp.sqlite
# MEMOS_MCP_ENABLE_FTS=true
# MEMOS_MCP_ENABLE_SEMANTIC_SEARCH=false
# MEMOS_MCP_EMBEDDING_PROVIDER=disabled
# MEMOS_MCP_EMBEDDING_MODEL=
# MEMOS_MCP_EMBEDDING_BASE_URL=
# MEMOS_MCP_EMBEDDING_API_KEY=
