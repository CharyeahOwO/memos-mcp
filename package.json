{
  "name": "memos-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for usememos/Memos with safe write tools and per-request auth.",
  "type": "module",
  "license": "MIT",
  "author": "CharyeahOwO",
  "homepage": "https://github.com/CharyeahOwO/memos-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharyeahOwO/memos-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "memos-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "cross-env MEMOS_MCP_TRANSPORT=http tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.16.0",
    "cross-env": "^7.0.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
