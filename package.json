{
  "name": "memos-mcp",
  "version": "0.1.0",
  "description": "Local-first Model Context Protocol server for usememos/Memos with safe write tools and local retrieval.",
  "type": "module",
  "license": "MIT",
  "author": "CharyeahOwO",
  "homepage": "https://github.com/CharyeahOwO/memos-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharyeahOwO/memos-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "memos-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    ".env.example",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "cross-env MEMOS_MCP_TRANSPORT=http tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:http": "cross-env MEMOS_MCP_TRANSPORT=http node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && npm run validate:examples",
    "validate:examples": "node scripts/validate-examples.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:memos": "node scripts/smoke-memos-api.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.16.0",
    "cross-env": "^7.0.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
